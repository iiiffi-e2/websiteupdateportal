# Copy to .env.local. Leave a value blank to keep that integration unconfigured.
# Do not put real secrets in this file.

# Required in production. Development uses a local default when this is unset.
AUTH_SECRET=

# Postgres connection. When unset, the app uses an embedded Postgres database in DATA_DIR.
# Use the Supabase transaction pooler connection string in hosted environments.
DATABASE_URL=

DATA_DIR=.data

# Set to false in production. Demo accounts are created only when this is not false.
SEED_DEMO=true

# Optional first administrator, used only when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG_NAME=Agency

# Supabase Auth. When both URL and anon key are set, password login uses Supabase
# and the service never falls back to the local password hash.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One local repository id. The demo site is lumen-studio.
LOCAL_ALLOWED_REPO=lumen-studio

# local_preview or vercel. A website whose provider does not match this value will not run.
DEPLOY_PROVIDER=local_preview

# One GitHub repository, owner/name. Required before a website can use the GitHub App.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_ALLOWED_REPO=

# Vercel preview and production deployments. The token stays on the server.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Claude. Prefer the Vercel AI Gateway. The direct key is used only when the gateway key is absent.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Protects POST /api/jobs/tick. Required before an external cron can run jobs.
JOB_TICK_SECRET=
JOB_GLOBAL_CONCURRENCY=2
